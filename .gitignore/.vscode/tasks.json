{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: active file",
      "type": "shell",
      "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },

    {
      "label": "build: project (all cpp)",
      "type": "shell",
      "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-g",
        "${workspaceFolder}\\**\\*.cpp",
        "-o",
        "${workspaceFolder}\\app.exe"
      ],
      "problemMatcher": ["$gcc"]
    },

    {
      "label": "run: active exe",
      "type": "shell",
      "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "dependsOn": "build: active file",
      "problemMatcher": []
    },

    {
      "label": "run: project",
      "type": "shell",
      "command": "${workspaceFolder}\\app.exe",
      "dependsOn": "build: project (all cpp)",
      "problemMatcher": []
    },

    {
      "label": "clean",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "del",
        "/q",
        "${workspaceFolder}\\*.exe"
      ],
      "problemMatcher": []
    }
  ]
}